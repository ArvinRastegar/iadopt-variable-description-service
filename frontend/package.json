{
  "name": "iadopt-vis",
  "version": "0.3.0",
  "description": "Visualize IAdopt Variables",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "test": "vitest --config=vitest.browser.config.js",
    "test:browser": "vitest --config=vitest.browser.config.js --project=browser",
    "test:unit": "vitest --config=vitest.browser.config.js --project=node"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/browser": "^4.0.18",
    "@vitest/browser-playwright": "^4.0.18",
    "eslint": "^9.39.3",
    "eslint-plugin-jsdoc": "^61.7.1",
    "globals": "^16.5.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vitest-browser-react": "2.3.0"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@comunica/query-sparql-rdfjs": "^4.5.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.53.0",
    "n3": "^1.26.0",
    "radix-ui": "1.7.0",
    "rdfxml-streaming-parser": "^3.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "packageManager": "pnpm@10.26.2",
  "license": "CC BY 4.0"
}
